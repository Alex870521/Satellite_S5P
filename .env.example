# Copernicus Open Access Hub API credentials (Sentinel-5P)
COPERNICUS_USERNAME=your_username
COPERNICUS_PASSWORD=your_password

# Copernicus S3 (eodata) keys — OPTIONAL but STRONGLY recommended for bulk downloads.
# The OData/zipper endpoint is rate limited to 4 concurrent connections; going
# over it earns HTTP 429s and the retry backoff makes throughput collapse.
# S3 has a separate quota and is several times faster.
#   measured 2026-09-22, Taiwan -> CDSE, single connection:
#     OData  3.4 MB/s   (4 connections ~15 MB/s, more => 429)
#     S3     9.3 MB/s   (8 connections ~36 MB/s, both can run at once)
# Generate a key pair (takes a minute, same login as above) at:
#   https://eodata-s3keysmanager.dataspace.copernicus.eu
# Endpoint: https://eodata.dataspace.copernicus.eu   bucket: eodata
# Each product's object key comes from its OData `S3Path` field, minus /eodata/.
S3_ACCESS_KEY=your_access_key
S3_SECRET_KEY=your_secret_key

# NASA EARTHDATA credentials (MODIS)
# NOTE: if MODIS fails with {"errors":["Token does not exist"]}, a stale bearer
# token on the `cmr.earthdata.nasa.gov` line of your ~/.netrc is being sent.
# Remove that line or regenerate the token at https://urs.earthdata.nasa.gov/
EARTHDATA_USERNAME=your_username
EARTHDATA_PASSWORD=your_password

# CDS API credentials (ERA5). The /api/v2 endpoint is retired; use /api.
CDSAPI_URL=https://cds.climate.copernicus.eu/api
CDSAPI_KEY=your_key

# GEMS (NIER Environmental Satellite Center) API key — single token, key-based auth
GEMS_API_KEY=your_key

# Where downloads/outputs are written. Defaults to ./data inside the repo;
# point it at an external drive for real work (archives run to terabytes).
SATELLITE_BASE_DIR=./data

# Optional: data spread over several drives (e.g. old years on an archive
# drive, new years on the working drive). os.pathsep-separated (':' on macOS
# / Linux). Used by scripts/l3_regrid_year.py and data-backed tests to find
# the same product across drives. Unset = just SATELLITE_BASE_DIR.
# SATELLITE_DATA_ROOTS=/Volumes/ArchiveDrive:/Volumes/WorkDrive

# Optional: root of the local gridded work files. Scripts write into subfolders:
# l3/ (l3_regrid_year.py), legacy_rbf/ (fetch_merge_delete_raw.py, download_process_aod.py), static/.
# Unset = ~/DataCenter/Satellite/Data.
# LOCAL_WORK_DIR=~/DataCenter/Satellite/Data

# Optional: where download_epa_stations.py writes MOENV station CSVs (<dir>/<year>/*.csv).
# Unset = ~/DataCenter/MOE_AQ_STATION.
# MOE_STATION_DIR=~/DataCenter/MOE_AQ_STATION
